# Kafka Dashboard — variables de entorno
#
# Estas variables se consumen desde backoffice/.env (mismo archivo que el resto del BackOffice).
# Copiar las que apliquen a `backoffice/.env` antes de levantar.

# Memory limits
KAFKA_DASHBOARD_FE_MEM_LIMIT=64m
KAFKA_DASHBOARD_BFF_MEM_LIMIT=256m

# Conexión Kafka (puerto 29092 = listener PLAINTEXT interno; 9092/19092/29092/39092 = listeners HOST/externos)
KAFKA_BOOTSTRAP_SERVERS=kafka1:29092,kafka2:29092,kafka3:29092
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# Logging del BFF
KAFKA_DASHBOARD_LOG_LEVEL=INFO

# Persistencia local
SQLITE_PATH=/data/app.db
OWNERS_YAML_PATH=/app/config/owners.yaml
