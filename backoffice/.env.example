# BackOffice stack — environment variables (template)
# Copia este archivo a `.env` y ajusta valores. Credenciales NO usar en producción.

COMPOSE_PROJECT_NAME=lg-infra-backoffice

# --- Versions ---
KEYCLOAK_VERSION=26.0
OAUTH2_PROXY_VERSION=v7.7.1-alpine
PORTAINER_VERSION=2.21.4
NGINX_VERSION=1.27-alpine

# --- Ports (host) ---
BACKOFFICE_PORT=8080
KEYCLOAK_PORT=8083

# --- Credentials (lab only) ---
BACKOFFICE_USER=lglabs
BACKOFFICE_PASS=lgpass
KEYCLOAK_ADMIN_USER=lglabs
KEYCLOAK_ADMIN_PASS=lgpass

# --- OIDC / SSO ---
OIDC_REALM=lglabs
OIDC_CLIENT_ID=oauth2-proxy
OIDC_CLIENT_SECRET=change-me
# Generar nuevo: openssl rand -base64 32
COOKIE_SECRET=change-me-base64-32-bytes

# --- Memory limits ---
KEYCLOAK_MEM_LIMIT=768m
OAUTH2_PROXY_MEM_LIMIT=128m
PORTAINER_MEM_LIMIT=256m
HOME_MEM_LIMIT=64m
